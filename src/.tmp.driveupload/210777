  const handleExportJson = () => {
    if (problems.length === 0) return alert("내보낼 문항 데이터가 없습니다.");
    const forced = bookTitle.trim();
    const normalized = sortProblemsList(
      problems.map((p) => {
        const norm = normalizeRecordForQuestionDb(p, forced);
        if (forced) {
          norm.book_name = forced;
          norm.source_book_name = forced;
        }
        return norm;
      })
    );
    const blob = new Blob([JSON.stringify(normalized, null, 2)], {
      type: "application/json;charset=utf-8",
    });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    const safeTitle = (bookTitle || "Problems").replace(/[\\/:*?"<>|]/g, "_");
    a.download = `${safeTitle}_Classified.json`;
    a.click();
    URL.revokeObjectURL(url);
