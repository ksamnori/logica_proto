  // 전역 클립보드 붙여넣기(Ctrl+V) 리스너: activeCropTarget 슬롯이 선택되어 있으면 즉시 붙여넣기
  useEffect(() => {
    const handleGlobalPaste = async (e: ClipboardEvent) => {
      if (!activeCropTarget) return;
      const items = e.clipboardData?.items;
      if (!items) return;
      for (const item of Array.from(items)) {
        if (item.type.startsWith("image/")) {
          e.preventDefault();
          const blob = item.getAsFile();
          if (blob) {
            await attachImageBlobToProblem(
              activeCropTarget.questionId,
              activeCropTarget.field,
              blob
            );
            addLog(
              `📋 클립보드 이미지 붙여넣기 완료 (${activeCropTarget.field})`
            );
            setActiveCropTarget(null);
          }
          break;
        }
      }
    };
    window.addEventListener("paste", handleGlobalPaste);
    return () => window.removeEventListener("paste", handleGlobalPaste);
  }, [activeCropTarget, attachImageBlobToProblem, addLog]);

  // 클립보드 API 직접 읽기 버튼
  const handleClipboardButtonPaste = async (
    questionId: string,
    field: ImageSlotField
  ) => {
    try {
      if (!navigator.clipboard || !navigator.clipboard.read) {
        setActiveCropTarget({ questionId, field });
        return alert(
          "슬롯이 선택되었습니다! 이제 키보드에서 Ctrl+V를 누르면 클립보드 이미지가 바로 들어갑니다."
        );
      }
      const items = await navigator.clipboard.read();
      for (const item of items) {
        const imgType = item.types.find((t) => t.startsWith("image/"));
        if (imgType) {
          const blob = await item.getType(imgType);
          await attachImageBlobToProblem(questionId, field, blob);
          addLog(`📋 클립보드 이미지 붙여넣기 완료 (${field})`);
          return;
        }
      }
      setActiveCropTarget({ questionId, field });
      alert("클립보드에 이미지가 없거나 권한이 필요합니다. Ctrl+V를 눌러 붙여넣으세요.");
    } catch {
      setActiveCropTarget({ questionId, field });
      alert("타겟 슬롯이 활성화되었습니다. 이제 키보드 Ctrl+V를 누르면 바로 붙여넣어집니다!");
    }
  };

  // V302: 가로 길이 통일 (비율 유지 리사이즈)
  const handleResizeImageWidth = async (
    questionId: string,
    field: ImageSlotField,
    targetWidth: number
  ) => {
    const assetKey = `${questionId}_${field}`;
    const asset = imageAssets[assetKey];
    const rawUrl = asset?.previewUrl || currentProblem?.[field];
    if (!rawUrl) return;

    try {
      const img = await new Promise<HTMLImageElement>((resolve, reject) => {
        const el = new Image();
        el.crossOrigin = "anonymous";
        el.onload = () => resolve(el);
        el.onerror = reject;
        el.src = rawUrl;
      });

      if (img.width === targetWidth) return;
      const newHeight = Math.round(img.height * (targetWidth / img.width));
      const canvas = document.createElement("canvas");
      canvas.width = targetWidth;
      canvas.height = newHeight;
      const ctx = canvas.getContext("2d");
      if (!ctx) return;
      ctx.drawImage(img, 0, 0, targetWidth, newHeight);

      const resizedBlob = await new Promise<Blob | null>((res) =>
        canvas.toBlob(res, "image/png")
      );
      if (resizedBlob) {
        await attachImageBlobToProblem(questionId, field, resizedBlob);
        addLog(
          `📏 [${field}] 가로 해상도 ${targetWidth} x ${newHeight} px 통일 완료`
        );
      }
    } catch (e: any) {
      alert(`이미지 리사이즈 실패: ${e.message}`);
    }
  };

  // 좌측 PDF 캔버스에서 드래그 크롭
  const handleMouseDown = (e: React.MouseEvent<HTMLDivElement>) => {
    e.preventDefault();
    if (!pdfDoc) return;
    isCroppingRef.current = true;
    const rect = e.currentTarget.getBoundingClientRect();
    cropStartRef.current = { x: e.clientX - rect.left, y: e.clientY - rect.top };
    cropRectRef.current = {
      x: e.clientX - rect.left,
      y: e.clientY - rect.top,
      w: 0,
      h: 0,
    };

    if (overlayRef.current) {
      overlayRef.current.style.display = "none";
      const isAns =
        activeCropTarget?.field === "answer_image_url" ||
        activeCropTarget?.field === "answer_image_2_url";
      overlayRef.current.className = isAns
        ? "absolute border-[3px] border-emerald-500 bg-emerald-500/20 pointer-events-none hidden z-20"
        : "absolute border-[3px] border-indigo-500 bg-indigo-500/20 pointer-events-none hidden z-20";
    }
  };

  const handleMouseMove = (e: React.MouseEvent<HTMLDivElement>) => {
    if (!isCroppingRef.current || !cropStartRef.current) return;
    const rect = e.currentTarget.getBoundingClientRect();
    const newRect = {
      x: Math.min(cropStartRef.current.x, e.clientX - rect.left),
      y: Math.min(cropStartRef.current.y, e.clientY - rect.top),
      w: Math.abs(e.clientX - rect.left - cropStartRef.current.x),
      h: Math.abs(e.clientY - rect.top - cropStartRef.current.y),
    };
    cropRectRef.current = newRect;

    if (overlayRef.current) {
      overlayRef.current.style.display = "block";
      overlayRef.current.style.left = `${newRect.x}px`;
      overlayRef.current.style.top = `${newRect.y}px`;
      overlayRef.current.style.width = `${newRect.w}px`;
      overlayRef.current.style.height = `${newRect.h}px`;
    }
  };

  const handleMouseUp = async () => {
    if (!isCroppingRef.current) return;
    isCroppingRef.current = false;
    if (overlayRef.current) overlayRef.current.style.display = "none";

    const box = cropRectRef.current;
    if (!box || box.w < 15 || box.h < 15 || !canvasRef.current) {
      cropRectRef.current = null;
      return;
    }

    const canvas = canvasRef.current;
    const rect = canvas.getBoundingClientRect();
    const scaleX = canvas.width / rect.width;
    const scaleY = canvas.height / rect.height;

    const tempCanvas = document.createElement("canvas");
    tempCanvas.width = Math.round(box.w * scaleX);
    tempCanvas.height = Math.round(box.h * scaleY);
    const tCtx = tempCanvas.getContext("2d");
    if (!tCtx) return;

    tCtx.drawImage(
      canvas,
      box.x * scaleX,
      box.y * scaleY,
      box.w * scaleX,
      box.h * scaleY,
      0,
      0,
      tempCanvas.width,
      tempCanvas.height
    );
    const blob = await new Promise<Blob | null>((res) =>
      tempCanvas.toBlob(res, "image/png")
    );
    if (!blob) return;

    if (activeCropTarget) {
      await attachImageBlobToProblem(
        activeCropTarget.questionId,
        activeCropTarget.field,
        blob
      );
      setActiveCropTarget(null);
    } else if (currentProblem) {
      await attachImageBlobToProblem(
        currentProblem.question_id,
        "image_url",
        blob
      );
    } else {
      // 문항이 하나도 없을 때 드래그하면 새 문항을 자동 생성하고 메인 이미지에 할당
      const newId = generateUUID();
      const newProb = normalizeRecordForQuestionDb(
        {
