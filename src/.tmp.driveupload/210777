                      className="w-full px-2 py-1.5 border border-slate-300 rounded-lg text-xs font-bold bg-white"
                    >
                      {COGNITIVE_LEVEL_OPTIONS.map((opt) => (
                        <option key={opt} value={opt}>
                          {opt}
                        </option>
                      ))}
                    </select>
                  </div>

                  <div>
                    <label className="block text-[11px] font-bold text-slate-600 mb-0.5">
                      📊 난이도
                    </label>
                    <select
                      value={normalizeDifficultyForDb(currentProblem.difficulty)}
                      onChange={(e) =>
                        updateCurrentProblemField("difficulty", e.target.value)
                      }
                      className="w-full px-2 py-1.5 border border-slate-300 rounded-lg text-xs font-bold bg-white"
                    >
                      {ALLOWED_DIFFICULTIES.map((d) => (
                        <option key={d} value={d}>
                          {d}
                        </option>
                      ))}
                    </select>
                  </div>

                  <div>
                    <label className="block text-[11px] font-bold text-slate-600 mb-0.5">
                      🎯 정답률 (%)
                    </label>
                    <select
                      value={String(currentProblem.solving_probability ?? 50)}
                      onChange={(e) =>
                        updateCurrentProblemField(
                          "solving_probability",
                          Number(e.target.value)
                        )
                      }
                      className="w-full px-2 py-1.5 border border-slate-300 rounded-lg text-xs font-bold bg-white"
                    >
                      {Array.from({ length: 20 }, (_, i) => (i + 1) * 5).map(
                        (val) => (
                          <option key={val} value={String(val)}>
                            {val}%
                          </option>
                        )
                      )}
                    </select>
                  </div>

                  <div>
                    <label className="block text-[11px] font-bold text-slate-600 mb-0.5">
                      🏷️ 문제유형 (problem_type)
                    </label>
                    <select
                      value={currentProblem.problem_type || "SUBJECTIVE"}
                      onChange={(e) =>
                        updateCurrentProblemField("problem_type", e.target.value)
                      }
                      className="w-full px-2 py-1.5 border border-indigo-300 rounded-lg text-xs font-extrabold text-indigo-800 bg-white"
                    >
                      {INTEGRATED_PROBLEM_TYPES.map((pt) => (
                        <option key={pt} value={pt}>
                          {pt === "MULTIPLE_CHOICE"
                            ? "MULTIPLE_CHOICE (객관식)"
                            : pt === "SUBJECTIVE"
                            ? "SUBJECTIVE (단답형)"
                            : pt === "DESCRIPTIVE"
                            ? "DESCRIPTIVE (서술형)"
                            : pt}
                        </option>
                      ))}
                    </select>
                  </div>
                </div>

                {/* 3열: 교재 이름 / 인쇄쪽 / 문항번호 / 소문항 / 3단계 */}
                <div className="grid grid-cols-2 sm:grid-cols-6 gap-2">
                  <div className="sm:col-span-2">
                    <label className="block text-[11px] font-bold text-slate-600 mb-0.5">
                      📚 교재 이름
                    </label>
                    <input
                      type="text"
                      value={
                        currentProblem.book_name ||
                        currentProblem.source_book_name ||
                        bookTitle
                      }
                      onChange={(e) =>
                        updateCurrentProblemField("book_name", e.target.value)
                      }
                      className="w-full px-2 py-1.5 border border-slate-300 rounded-lg text-xs font-bold bg-white"
                    />
                  </div>
                  <div>
                    <label className="block text-[11px] font-bold text-slate-600 mb-0.5">
                      📄 인쇄쪽
                    </label>
                    <input
                      type="text"
                      value={currentProblem.final_printed_page || ""}
                      onChange={(e) =>
                        updateCurrentProblemField(
                          "final_printed_page",
                          e.target.value
                        )
                      }
                      className="w-full px-2 py-1.5 border border-slate-300 rounded-lg text-xs font-bold bg-white text-center"
                    />
                  </div>
                  <div>
                    <label className="block text-[11px] font-bold text-slate-600 mb-0.5">
                      🔢 문항번호
                    </label>
                    <input
                      type="text"
                      value={currentProblem.question_number || ""}
                      onChange={(e) =>
                        updateCurrentProblemField(
                          "question_number",
                          e.target.value
                        )
                      }
                      className="w-full px-2 py-1.5 border border-slate-300 rounded-lg text-xs font-bold bg-white text-center"
                    />
                  </div>
                  <div>
                    <label className="block text-[11px] font-bold text-slate-600 mb-0.5">
                      🔗 소문항 (sub)
                    </label>
                    <input
                      type="number"
                      min={0}
                      value={currentProblem.sub_num ?? 0}
                      onChange={(e) =>
                        updateCurrentProblemField(
                          "sub_num",
                          parseInt(e.target.value, 10) || 0
                        )
                      }
                      className="w-full px-2 py-1.5 border border-slate-300 rounded-lg text-xs font-bold bg-white text-center"
                    />
                  </div>
                  <div>
                    <label className="block text-[11px] font-bold text-slate-600 mb-0.5">
                      🔗 3단계 (sub_sub)
                    </label>
                    <input
                      type="number"
                      min={0}
                      value={currentProblem.sub_sub_num ?? 0}
                      onChange={(e) =>
                        updateCurrentProblemField(
                          "sub_sub_num",
                          parseInt(e.target.value, 10) || 0
                        )
                      }
                      className="w-full px-2 py-1.5 border border-slate-300 rounded-lg text-xs font-bold bg-white text-center"
                    />
                  </div>
                </div>
              </div>

              {/* 엑스레이 디버그 모드 */}
              {debugMode && (
                <div className="bg-rose-950 text-rose-100 p-3 rounded-xl font-mono text-xs space-y-1">
                  <div className="font-bold text-rose-300">
                    🚨 [엑스레이 모드] 원본 LaTeX 데이터 (ID: {currentProblem.question_id})
                  </div>
                  <pre className="whitespace-pre-wrap break-all">
                    [question]{"\n"}
                    {currentProblem.question || ""}
                    {"\n\n"}[question_2]{"\n"}
                    {currentProblem.question_2 || "(null)"}
                  </pre>
                </div>
              )}

              {/* =========================================================
                  텍스트 미리보기 & 직접 수정 탭 (question ➔ image ➔ question_2 + 4단계 해설)
              ========================================================= */}
              <div className="border border-slate-200 rounded-xl overflow-hidden">
                <div className="bg-slate-100 border-b border-slate-200 px-3 py-2 flex items-center justify-between">
                  <div className="flex items-center gap-1.5">
                    <button
                      onClick={() => setEditorTab("EDIT")}
                      className={`px-3 py-1 rounded-lg text-xs font-extrabold transition-colors ${
                        editorTab === "EDIT"
                          ? "bg-indigo-600 text-white"
                          : "text-slate-600 hover:bg-slate-200"
                      }`}
                    >
                      ✏️ 직접 수정하기
                    </button>
                    <button
                      onClick={() => setEditorTab("VIEW")}
                      className={`px-3 py-1 rounded-lg text-xs font-extrabold transition-colors ${
                        editorTab === "VIEW"
                          ? "bg-indigo-600 text-white"
                          : "text-slate-600 hover:bg-slate-200"
                      }`}
                    >
                      👀 렌더링 미리보기 (실제 출력 순서)
                    </button>
                  </div>
                  <span className="text-[11px] font-bold text-slate-500">
                    출력 순서: question ➔ image_1 ➔ image_2 ➔ question_2
                  </span>
                </div>

                {editorTab === "VIEW" ? (
                  <div className="p-4 space-y-3 bg-white text-sm text-slate-800">
                    <div className="p-3 rounded-lg bg-slate-50 border border-slate-200">
                      <div className="text-xs font-extrabold text-indigo-700 mb-1">
                        [문제 1 — 이미지 상단 (question)]
                      </div>
                      <div className="whitespace-pre-wrap leading-relaxed">
                        {currentProblem.question || "(내용 없음)"}
                      </div>
                    </div>

                    {(currentProblem.image_url || currentProblem.image_2_url) && (
                      <div className="text-center text-xs font-bold text-slate-500 py-1 bg-slate-100 rounded">
                        ⬇️ 이미지 출력 위치 (
                        {[
                          currentProblem.image_url ? "문제 이미지 1" : null,
                          currentProblem.image_2_url ? "문제 이미지 2" : null,
                        ]
                          .filter(Boolean)
                          .join(" / ")}
                        ) ⬇️
                      </div>
                    )}

                    {currentProblem.question_2 && (
                      <div className="p-3 rounded-lg bg-violet-50/50 border border-violet-200">
                        <div className="text-xs font-extrabold text-violet-700 mb-1">
                          [문제 2 — 이미지 하단 (question_2)]
                        </div>
                        <div className="whitespace-pre-wrap leading-relaxed">
                          {currentProblem.question_2}
                        </div>
                      </div>
                    )}

                    <div className="grid grid-cols-1 gap-2 pt-2 border-t border-slate-200">
                      <div className="p-2.5 rounded-lg bg-emerald-50 border border-emerald-200">
                        <span className="text-xs font-extrabold text-emerald-800 mr-2">
                          🎯 [정답]
                        </span>
                        <span className="font-bold text-emerald-950">
                          {currentProblem.answer || "(미입력)"}
                        </span>
                      </div>
                      <div className="p-2.5 rounded-lg bg-slate-50 border border-slate-200 space-y-1.5 text-xs">
                        <div>
                          <strong className="text-indigo-700">[스텝 1: 개념]</strong>{" "}
                          {currentProblem.step_1_concept || "-"}
                        </div>
                        <div>
                          <strong className="text-indigo-700">[스텝 2: 전략]</strong>{" "}
                          {currentProblem.step_2_approach || "-"}
                        </div>
                        <div className="whitespace-pre-wrap">
                          <strong className="text-indigo-700">[스텝 3: 풀이]</strong>{" "}
                          {currentProblem.step_3_process || "-"}
                        </div>
                        <div>
                          <strong className="text-indigo-700">[스텝 4: 결론]</strong>{" "}
                          {currentProblem.step_4_conclusion || "-"}
                        </div>
                      </div>
                    </div>
                  </div>
                ) : (
                  <div className="p-3 space-y-2.5 bg-white">
                    <div>
                      <label className="block text-xs font-extrabold text-slate-700 mb-1">
                        📌 문제 1 — 이미지 상단 출력 (question)
                      </label>
                      <textarea
                        value={currentProblem.question || ""}
                        onChange={(e) =>
                          updateCurrentProblemField("question", e.target.value)
                        }
                        rows={4}
                        className="w-full p-2.5 border border-slate-300 rounded-lg font-mono text-xs leading-relaxed focus:ring-2 focus:ring-indigo-500 outline-none bg-yellow-50/20"
                      />
                    </div>

                    {/* V302 원클릭 분리/병합 버튼 */}
                    <div className="grid grid-cols-2 gap-2">
                      <button
                        onClick={handleSplitLastLineToQ2}
                        className="py-1.5 px-3 bg-violet-50 hover:bg-violet-100 text-violet-800 border border-violet-200 rounded-lg text-xs font-extrabold"
                      >
                        ✂️ 문제 1의 마지막 줄(문단)을 문제 2(question_2)로 내리기
                      </button>
                      <button
                        onClick={handleMergeQ2ToQ1}
                        className="py-1.5 px-3 bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-300 rounded-lg text-xs font-extrabold"
                      >
                        ⬆️ 문제 2(question_2)를 문제 1 끝으로 다시 합치기
                      </button>
                    </div>

                    <div>
                      <label className="block text-xs font-extrabold text-slate-700 mb-1">
                        📌 문제 2 — 이미지 하단 출력 (question_2, 선택)
                      </label>
                      <textarea
                        value={currentProblem.question_2 || ""}
                        onChange={(e) =>
                          updateCurrentProblemField(
                            "question_2",
                            e.target.value || null
                          )
                        }
                        placeholder="그래프/도형 이미지 아래에 출력될 발문이나 소문항이 있을 때 여기에 분리해 넣어주세요."
                        rows={2}
                        className="w-full p-2 border border-slate-300 rounded-lg font-mono text-xs leading-relaxed focus:ring-2 focus:ring-violet-500 outline-none"
                      />
                    </div>

                    <div>
                      <label className="block text-xs font-extrabold text-emerald-700 mb-1">
                        🎯 정답 (answer)
                      </label>
                      <input
                        type="text"
                        value={currentProblem.answer || ""}
                        onChange={(e) =>
                          updateCurrentProblemField("answer", e.target.value)
                        }
                        className="w-full p-2 border border-emerald-300 rounded-lg font-mono text-xs font-bold bg-emerald-50/20 focus:ring-2 focus:ring-emerald-500 outline-none"
                      />
                    </div>

                    <div className="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1">
                      <div>
                        <label className="block text-[11px] font-bold text-slate-600 mb-0.5">
                          📖 해설 1: 핵심 개념 (step_1_concept)
                        </label>
                        <textarea
                          value={currentProblem.step_1_concept || ""}
                          onChange={(e) =>
                            updateCurrentProblemField(
                              "step_1_concept",
                              e.target.value
                            )
                          }
                          rows={2}
                          className="w-full p-2 border border-slate-300 rounded-lg font-mono text-xs"
                        />
                      </div>
                      <div>
                        <label className="block text-[11px] font-bold text-slate-600 mb-0.5">
                          🤔 해설 2: 접근 전략 (step_2_approach)
                        </label>
                        <textarea
                          value={currentProblem.step_2_approach || ""}
                          onChange={(e) =>
                            updateCurrentProblemField(
                              "step_2_approach",
                              e.target.value
                            )
                          }
                          rows={2}
                          className="w-full p-2 border border-slate-300 rounded-lg font-mono text-xs"
                        />
                      </div>
                      <div>
                        <label className="block text-[11px] font-bold text-slate-600 mb-0.5">
                          ✍️ 해설 3: 풀이 과정 (step_3_process)
                        </label>
                        <textarea
                          value={currentProblem.step_3_process || ""}
                          onChange={(e) =>
                            updateCurrentProblemField(
                              "step_3_process",
                              e.target.value
                            )
                          }
                          rows={3}
                          className="w-full p-2 border border-slate-300 rounded-lg font-mono text-xs"
                        />
                      </div>
                      <div>
                        <label className="block text-[11px] font-bold text-slate-600 mb-0.5">
                          ✅ 해설 4: 결론 (step_4_conclusion)
                        </label>
                        <textarea
                          value={currentProblem.step_4_conclusion || ""}
                          onChange={(e) =>
                            updateCurrentProblemField(
                              "step_4_conclusion",
                              e.target.value
                            )
                          }
                          rows={3}
                          className="w-full p-2 border border-slate-300 rounded-lg font-mono text-xs"
                        />
                      </div>
                    </div>
                  </div>
                )}
              </div>

              {/* =========================================================
                  ✂️ 정밀 이미지 센터 (V302 4슬롯: 문제 이미지 1·2 / 해설 이미지 1·2)
              ========================================================= */}
              <div className="space-y-2">
                <h3 className="text-xs font-extrabold text-slate-800 flex items-center gap-1.5">
                  <span>✂️</span> 정밀 이미지 센터 (4슬롯: PDF 드래그 크롭 · Ctrl+V 클립보드 붙여넣기 · 가로 px 통일)
                </h3>
                <div className="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                  {renderImageSlotCard(
                    "image_url",
                    "🖼️ 문제 이미지 1 (image_url)",
                    "bg-indigo-100 text-indigo-800"
                  )}
                  {renderImageSlotCard(
                    "image_2_url",
                    "🖼️ 문제 이미지 2 (image_2_url)",
                    "bg-violet-100 text-violet-800"
                  )}
                  {renderImageSlotCard(
                    "answer_image_url",
                    "📝 해설 이미지 1 (answer_image_url)",
                    "bg-emerald-100 text-emerald-800"
                  )}
                  {renderImageSlotCard(
                    "answer_image_2_url",
                    "📝 해설 이미지 2 (answer_image_2_url)",
                    "bg-teal-100 text-teal-800"
                  )}
                </div>
              </div>
            </div>
          )}

          {/* 하단 고정: V302 4-Way 결재 바 & DB 업로드 옵션 */}
          <div className="p-3 bg-slate-50 border-t border-slate-200 flex flex-wrap items-center justify-between gap-2 shrink-0">
            <div className="grid grid-cols-4 gap-2 flex-1 min-w-[280px]">
              <button
                onClick={() => selectProblemIndex(Math.max(0, currentIdx - 1))}
                disabled={currentIdx <= 0}
                className="py-2 bg-white hover:bg-slate-100 disabled:opacity-40 text-slate-800 border border-slate-300 rounded-xl text-xs font-extrabold"
              >
                ⬅️ 이전
              </button>
              <button
                onClick={() => handleVerificationDecision("PENDING")}
                disabled={!currentProblem}
                className="py-2 bg-amber-50 hover:bg-amber-100 disabled:opacity-40 text-amber-800 border border-amber-300 rounded-xl text-xs font-extrabold"
              >
                ⏸️ 보류
              </button>
              <button
                onClick={() => handleVerificationDecision("REJECTED")}
                disabled={!currentProblem}
                className="py-2 bg-rose-50 hover:bg-rose-100 disabled:opacity-40 text-rose-700 border border-rose-300 rounded-xl text-xs font-extrabold"
              >
                ❌ 반려
              </button>
              <button
                onClick={() => handleVerificationDecision("APPROVED")}
                disabled={!currentProblem}
                className="py-2 bg-indigo-600 hover:bg-indigo-500 disabled:opacity-40 text-white rounded-xl text-xs font-extrabold shadow"
              >
                ✅ 승인 (다음)
              </button>
            </div>

            <label className="flex items-center gap-1.5 text-[11px] font-bold text-slate-600 cursor-pointer">
              <input
                type="checkbox"
                checked={updateExistingOnlyMeta}
                onChange={(e) => setUpdateExistingOnlyMeta(e.target.checked)}
              />
              <span>🔒 DB 적재 시 기존 문항은 분류/난이도/유형만 업데이트</span>
            </label>
          </div>
        </div>
      </div>

      {/* =========================================================
          슬롯 내부 이미지 재크롭 모달 (V302 st_cropper 대응)
      ========================================================= */}
      {inPlaceCropModal && (
        <div className="fixed inset-0 bg-slate-950/75 z-50 flex items-center justify-center p-6">
          <div className="bg-white rounded-2xl max-w-3xl w-full p-5 shadow-2xl flex flex-col gap-4 max-h-[90vh]">
            <div className="flex justify-between items-center border-b border-slate-200 pb-3">
              <h3 className="font-extrabold text-slate-900 text-sm">
                ✂️ 이미지 영역 다시 자르기 ({inPlaceCropModal.field})
              </h3>
              <button
                onClick={() => setInPlaceCropModal(null)}
                className="text-slate-400 hover:text-slate-700 font-bold text-sm"
              >
                ✕ 닫기
              </button>
            </div>

            <div className="flex-1 overflow-auto flex items-center justify-center bg-slate-100 p-4 rounded-xl">
              <div
                className="relative inline-block select-none"
                onMouseDown={(e) => {
                  e.preventDefault();
                  isInPlaceCroppingRef.current = true;
                  const r = e.currentTarget.getBoundingClientRect();
                  inPlaceCropStartRef.current = {
                    x: e.clientX - r.left,
                    y: e.clientY - r.top,
                  };
                  inPlaceCropRectRef.current = {
                    x: e.clientX - r.left,
                    y: e.clientY - r.top,
                    w: 0,
                    h: 0,
                  };
                  if (inPlaceOverlayRef.current) {
                    inPlaceOverlayRef.current.style.display = "none";
                  }
                }}
                onMouseMove={(e) => {
                  if (
                    !isInPlaceCroppingRef.current ||
                    !inPlaceCropStartRef.current
                  )
                    return;
                  const r = e.currentTarget.getBoundingClientRect();
                  const nextR = {
                    x: Math.min(inPlaceCropStartRef.current.x, e.clientX - r.left),
                    y: Math.min(inPlaceCropStartRef.current.y, e.clientY - r.top),
                    w: Math.abs(e.clientX - r.left - inPlaceCropStartRef.current.x),
                    h: Math.abs(e.clientY - r.top - inPlaceCropStartRef.current.y),
                  };
                  inPlaceCropRectRef.current = nextR;
                  if (inPlaceOverlayRef.current) {
                    inPlaceOverlayRef.current.style.display = "block";
                    inPlaceOverlayRef.current.style.left = `${nextR.x}px`;
                    inPlaceOverlayRef.current.style.top = `${nextR.y}px`;
                    inPlaceOverlayRef.current.style.width = `${nextR.w}px`;
                    inPlaceOverlayRef.current.style.height = `${nextR.h}px`;
                  }
                }}
                onMouseUp={() => {
                  isInPlaceCroppingRef.current = false;
                }}
              >
                <img
                  ref={inPlaceImgRef}
                  src={inPlaceCropModal.srcUrl}
                  crossOrigin="anonymous"
                  alt="Crop target"
                  className="max-w-full max-h-[60vh] block pointer-events-none"
                />
                <div
                  ref={inPlaceOverlayRef}
                  className="absolute border-2 border-rose-500 bg-rose-500/20 pointer-events-none hidden"
                />
              </div>
            </div>

            <div className="flex justify-end gap-2">
              <button
                onClick={() => setInPlaceCropModal(null)}
                className="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-bold"
              >
                취소
              </button>
              <button
                onClick={handleInPlaceCropSave}
                className="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg text-xs font-extrabold"
              >
                💾 자르기 저장
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}