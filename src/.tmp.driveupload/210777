  // =========================================================
  const fetchWithRetryAndTimeout = async (
    payload: any,
    token: string | undefined,
    maxRetries = 5,
    timeoutMs = 60000
  ): Promise<any> => {
    let delay = 3000;
    for (let attempt = 0; attempt < maxRetries; attempt++) {
      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), timeoutMs);
      try {
        const res = await fetch("/api/gemini-parse", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${token || ""}`,
          },
          body: JSON.stringify(payload),
          signal: controller.signal,
        });
        clearTimeout(timer);

        const data = await res.json();
        if (!res.ok || !data.success) {
          const errMsg = String(data?.error || `HTTP ${res.status}`);
          if (
            errMsg.includes("503") ||
            errMsg.includes("429") ||
            errMsg.includes("Quota") ||
            errMsg.includes("ResourceExhausted")
          ) {
            const jitter = 500 + Math.random() * 2000;
            const waitTime = delay + jitter;
            addLog(
              `⚠️ [API 지연/제한] ${(waitTime / 1000).toFixed(
                1
              )}초 대기 후 재도전... (${attempt + 1}/${maxRetries})`
            );
            await new Promise((r) => setTimeout(r, waitTime));
            delay *= 1.5;
            continue;
          }
          throw new Error(errMsg);
        }
        return data.data;
      } catch (err: any) {
        clearTimeout(timer);
        if (err?.name === "AbortError") {
          addLog(
            `⚠️ [API 무한대기 감지] 60초 초과로 통신 강제 절단. 재도전... (${
              attempt + 1
            }/${maxRetries})`
          );
          await new Promise((r) => setTimeout(r, delay));
          delay *= 1.5;
          continue;
        }
        if (attempt === maxRetries - 1) throw err;
        await new Promise((r) => setTimeout(r, delay));
        delay *= 1.5;
      }
    }
    return null;
  };

  // PDF 한 페이지를 250 DPI (scale ≈ 3.47) JPEG Base64로 렌더링
  const renderPdfPageToBase64 = async (
    targetPdf: any,
    targetPageNum: number,
    dpi = 250
  ): Promise<string> => {
    const page = await targetPdf.getPage(targetPageNum);
    const scale = dpi / 72.0;
    const viewport = page.getViewport({ scale });
    const tempCanvas = document.createElement("canvas");
    tempCanvas.width = viewport.width;
    tempCanvas.height = viewport.height;
    const ctx = tempCanvas.getContext("2d");
    if (!ctx) throw new Error("Canvas context 생성 실패");
    await page.render({ canvasContext: ctx, viewport }).promise;
    return tempCanvas.toDataURL("image/jpeg", 0.82);
  };

  const runSinglePdfPipeline = async (
    targetPdfDoc: any,
    pdfFileName: string,
    startP: number,
    endP: number,
    token: string | undefined
  ) => {
    const cleanBookName = pdfFileName.replace(/\.pdf$/i, "");
    const completedSet = new Set<number>(
      useResumeTracker ? completedPagesMap[pdfFileName] || [] : []
    );

    const pagesToProcess: number[] = [];
    for (let p = startP; p <= endP; p++) {
      if (!completedSet.has(p)) pagesToProcess.push(p);
    }

    const skipCount = endP - startP + 1 - pagesToProcess.length;
    if (skipCount > 0) {
      addLog(
        `🔄 [이어하기 감지] ${pdfFileName}: 이미 완료된 ${skipCount}개 페이지를 0.1초 만에 건너뜁니다.`
      );
    }
    if (pagesToProcess.length === 0) {
      addLog(`🎉 [${pdfFileName}] 지정된 모든 페이지(${startP}~${endP}쪽)가 이미 처리되었습니다!`);
      return;
    }

    addLog(
      `🚀 [${pdfFileName}] 남은 ${pagesToProcess.length}장 스트리밍 스캔 시작 (모드: ${
        extractMode === "WITH_SOLUTION" ? "추출+4단계풀이(V119.1)" : "문제만 초고속 추출(V114.1)"
      }, 동시성: ${pageConcurrency})`
    );

    setAiProgress({
      current: 0,
      total: pagesToProcess.length,
      phaseLabel: `${pdfFileName} 스캔 중`,
    });

    const sharedPrintedPages: Record<number, number> = {};
    let doneCount = 0;

    // 동시성 워커 풀 실행
    let queueIdx = 0;
    const workerCount = Math.max(1, Math.min(pageConcurrency, pagesToProcess.length));

    const runWorker = async () => {
      while (queueIdx < pagesToProcess.length) {
        if (abortScanRef.current) break;
        const myIndex = queueIdx++;
        const pNum = pagesToProcess[myIndex];

        try {
          setPageNum(pNum);
          addLog(`📂 물리적 [${pNum}쪽] 이미지 렌더링(250 DPI) 및 문제 추출 시작...`);
          const base64Img = await renderPdfPageToBase64(targetPdfDoc, pNum, 250);

          const extractRes = await fetchWithRetryAndTimeout(
            {
              action: "extract",
              imageBase64: base64Img,
              pageNum: pNum,
            },
            token
          );

          const rawItems: any[] = extractRes?.problems || [];
          if (!rawItems || rawItems.length === 0) {
            addLog(`⏭️ 물리적 [${pNum}쪽] 문제 없음 (빈 페이지 완료 도장 기록)`);
            completedSet.add(pNum);
            setCompletedPagesMap((prev) => ({
              ...prev,
              [pdfFileName]: Array.from(completedSet),
            }));
            doneCount++;
            setAiProgress((prev) => ({ ...prev, current: doneCount }));
            continue;
          }

          // 인쇄된 페이지 번호 추론
          let currentPrintedPage: number | null = null;
          for (const item of rawItems) {
            const rawPage = String(item?.final_printed_page || "");
            const cleaned = rawPage.replace(/\D/g, "").replace(/^0+/, "");
            if (cleaned) {
              currentPrintedPage = parseInt(cleaned, 10);
              break;
            }
          }
          if (currentPrintedPage === null) {
            const prevPrinted = sharedPrintedPages[pNum - 1];
            currentPrintedPage = prevPrinted ? prevPrinted + 1 : pNum;
          }
          sharedPrintedPages[pNum] = currentPrintedPage;

          const seenInPage = new Set<string>();
          const pageExtractedItems: any[] = [];

          for (const item of rawItems) {
            if (!item || typeof item !== "object") continue;
            let qNum = String(item.question_number || "")
              .trim()
              .replace(/^0+/, "");
            if (!qNum || qNum.toLowerCase() === "none" || qNum.toLowerCase() === "null") {
              continue;
            }

            const cleanQText = cleanLatex(applySafeCleaner(item.question));
            if (!cleanQText) continue;

            if (
              qNum.includes("개념") ||
              qNum.toUpperCase().includes("QUIZ") ||
              qNum.includes("노트")
            ) {
              qNum = "Q";
            } else if (qNum.includes("확인")) {
              qNum = qNum.replace(/\s+/g, "");
            } else if (/^확인\s*\d+/.test(cleanQText) && !qNum.includes("확인")) {
              qNum = `확인${qNum}`.replace(/\s+/g, "");
            }

            const normText = cleanQText.replace(/\s+/g, "");
            if (seenInPage.has(normText)) continue;
            seenInPage.add(normText);

            const newRecord = normalizeRecordForQuestionDb(
              {
                question_id: generateUUID(),
                parent_question_id: null,
                pdf_source: pdfFileName,
                book_name: bookTitle || cleanBookName,
                source_book_name: bookTitle || cleanBookName,
                detected_page_num: pNum,
                final_printed_page: String(currentPrintedPage),
                question_number: qNum,
                sub_num: item.sub_num ?? 0,
                sub_sub_num: item.sub_sub_num ?? 0,
                problem_type: "SUBJECTIVE",
                difficulty: "중",
                solving_probability: 50,
                question: cleanQText,
                question_2: null,
                options: null,
                answer: "",
                step_1_concept: "",
                step_2_approach: "",
                step_3_process: "",
                step_4_conclusion: "",
                ai_status: extractMode === "WITH_SOLUTION" ? "대기" : "추출완료",
                classification_status: "PENDING",
                verification_status: "PENDING",
                is_human_verified: false,
                human_verified: false,
                engine_ver:
                  extractMode === "WITH_SOLUTION"
                    ? "V119.1_Stream_Bulletproof"
                    : "V114.1_SOTA_Async_Parser",
              },
              bookTitle || cleanBookName
            );

            pageExtractedItems.push(newRecord);
          }

          // 모드 2: 추출 직후 전 문항 동시 4단계 풀이 생성 (V119.1 공장 라인 2)
          if (extractMode === "WITH_SOLUTION" && pageExtractedItems.length > 0) {
            addLog(
              `✅ 물리적 [${pNum}쪽] (인쇄 ${currentPrintedPage}쪽) ${pageExtractedItems.length}문항 추출 완료! 🚀 전 문항 동시 4단계 풀이 진입...`
            );
            await Promise.all(
              pageExtractedItems.map(async (item) => {
                try {
                  const solData = await fetchWithRetryAndTimeout(
                    {
                      action: "solve",
                      imageBase64: base64Img,
                      question: item.question,
                      question_number: item.question_number,
                      sub_num: item.sub_num,
                    },
                    token
                  );
                  if (solData) {
                    item.step_1_concept = cleanLatex(solData.step_1_concept || "");
                    item.step_2_approach = cleanLatex(solData.step_2_approach || "");
                    item.step_3_process = cleanLatex(solData.step_3_process || "");
                    item.step_4_conclusion = cleanLatex(solData.step_4_conclusion || "");
                    item.answer = cleanLatex(solData.answer || "");
                    item.problem_type = normalizeRecordForQuestionDb(item).problem_type;
                    item.ai_status = "완료";
                    addLog(
                      `💡 [풀이 완료] 인쇄 ${item.final_printed_page}쪽 ${item.question_number}번 ➜ 정답: ${item.answer}`
                    );
                  } else {
                    item.ai_status = "에러";
                  }
                } catch (solErr: any) {
                  item.ai_status = "에러";
                  addLog(
                    `❌ [풀이 실패] 인쇄 ${item.final_printed_page}쪽 ${item.question_number}번: ${solErr.message}`
                  );
                }
              })
            );
          } else {
            addLog(
              `✅ 물리적 [${pNum}쪽] (인쇄 ${currentPrintedPage}쪽) ${pageExtractedItems.length}문항 초고속 추출 완료!`
            );
          }

          // 원자적 병합 및 정렬 (같은 PDF + 같은 detected_page_num 기존 잔여 데이터 교체)
          setProblems((prev) => {
            const filtered = prev.filter(
              (p) =>
                !(
                  (p.pdf_source === pdfFileName || !p.pdf_source) &&
                  Number(p.detected_page_num) === pNum
                )
            );
            const merged = sortProblemsList([...filtered, ...pageExtractedItems]);

            // 단일 소문항 sub_num 정리 (같은 페이지+문항번호가 1개뿐이고 sub_sub_num이 0이면 sub_num=0)
            const qCounts: Record<string, number> = {};
            for (const m of merged) {
              const key = `${m.pdf_source || ""}_${m.detected_page_num}_${m.question_number}`;
              qCounts[key] = (qCounts[key] || 0) + 1;
            }
            return merged.map((m) => {
              const key = `${m.pdf_source || ""}_${m.detected_page_num}_${m.question_number}`;
              if (qCounts[key] === 1 && (!m.sub_sub_num || m.sub_sub_num === 0)) {
                return { ...m, sub_num: 0 };
              }
              return m;
            });
          });

          completedSet.add(pNum);
          setCompletedPagesMap((prev) => ({
            ...prev,
            [pdfFileName]: Array.from(completedSet),
          }));
        } catch (pageErr: any) {
          addLog(`❌ 물리적 [${pNum}쪽] 처리 실패 (진행도 미기록, 다음 실행 시 재시도): ${pageErr.message}`);
        } finally {
          doneCount++;
          setAiProgress((prev) => ({ ...prev, current: doneCount }));
        }
      }
    };

    await Promise.all(Array.from({ length: workerCount }, () => runWorker()));
  };

  const handleStartPhase1Scan = async () => {
    if (!runAllPdfsMode && !pdfDoc) {
      return alert("먼저 PDF 파일을 드래그하거나 선택해주세요.");
    }
    if (!runAllPdfsMode && aiStartPage > aiEndPage) {
      return alert("시작 페이지가 끝 페이지보다 클 수 없습니다.");
    }

    abortScanRef.current = false;
    setIsAiScanning(true);

    try {
      const {
        data: { session },
      } = await supabase.auth.getSession();
      const token = session?.access_token;

      if (runAllPdfsMode && pdfQueue.length > 0) {
        addLog(`🚀 대기열 내 전체 PDF 파일(${pdfQueue.length}개) 일괄 처리를 시작합니다!`);
        for (const qItem of pdfQueue) {
          if (abortScanRef.current) break;
          const loadedPdf = await loadPdfFileObject(qItem.file);
          if (!loadedPdf) continue;
          setSelectedPdfName(qItem.name);
          setPdfDoc(loadedPdf);
          setNumPages(loadedPdf.numPages);
          await runSinglePdfPipeline(
            loadedPdf,
            qItem.name,
            1,
            loadedPdf.numPages,
            token
          );
        }
        addLog(`🎉 대기열 내 모든 PDF 파일 일괄 처리가 완료되었습니다!`);
      } else {
        const targetName = selectedPdfName || `${bookTitle || "workbook"}.pdf`;
        await runSinglePdfPipeline(
          pdfDoc,
          targetName,
          aiStartPage,
          aiEndPage,
          token
        );
        addLog(`🎉 [${targetName}] 지정 구간(${aiStartPage}~${aiEndPage}쪽) 스캔 완료!`);
      }
    } catch (e: any) {
      alert(`스캔 중 오류 발생: ${e.message}`);
    } finally {
      setIsAiScanning(false);
    }
  };

  // 문제만 추출된 문항들에 대해 사후 4단계 AI 풀이 일괄 실행
  const handleSolveMissingAnswers = async () => {
    if (!pdfDoc) {
      return alert("원본 도형/이미지를 참조하기 위해 해당 PDF 파일이 열려 있어야 합니다.");
    }
    const unsolved = problems.filter(
      (p) => !p.answer || !p.step_1_concept || p.ai_status !== "완료"
    );
    if (unsolved.length === 0) {
      return alert("모든 문항에 이미 정답과 4단계 해설이 작성되어 있습니다.");
    }

    setIsAiScanning(true);
    abortScanRef.current = false;
    setAiProgress({
      current: 0,
      total: unsolved.length,
      phaseLabel: "미완성 4단계 해설 생성 중",
    });

    try {
      const {
        data: { session },
      } = await supabase.auth.getSession();
      const token = session?.access_token;
      const pageImgCache: Record<number, string> = {};
      let done = 0;

      for (const item of unsolved) {
        if (abortScanRef.current) break;
        const pNum = Math.max(1, Math.min(numPages, Number(item.detected_page_num) || 1));
        if (!pageImgCache[pNum]) {
          pageImgCache[pNum] = await renderPdfPageToBase64(pdfDoc, pNum, 250);
        }
        try {
          const solData = await fetchWithRetryAndTimeout(
            {
              action: "solve",
              imageBase64: pageImgCache[pNum],
              question: item.question,
              question_number: item.question_number,
              sub_num: item.sub_num,
            },
            token
          );
          if (solData) {
            setProblems((prev) =>
              prev.map((q) =>
                q.question_id === item.question_id
                  ? normalizeRecordForQuestionDb({
                      ...q,
                      step_1_concept: cleanLatex(solData.step_1_concept || ""),
                      step_2_approach: cleanLatex(solData.step_2_approach || ""),
                      step_3_process: cleanLatex(solData.step_3_process || ""),
                      step_4_conclusion: cleanLatex(solData.step_4_conclusion || ""),
                      answer: cleanLatex(solData.answer || ""),
                      ai_status: "완료",
                    })
                  : q
              )
            );
          }
        } catch (err: any) {
          addLog(`❌ ${item.question_number}번 풀이 실패: ${err.message}`);
        }
        done++;
        setAiProgress((prev) => ({ ...prev, current: done }));
      }
      addLog(`🎉 미완성 문항 ${done}개 4단계 해설 생성 완료!`);
    } finally {
      setIsAiScanning(false);
    }
  };

  // =========================================================
  // 🧭 Phase 2: 정밀 분류 (교과 Depth 8 + 광범위 서브교과 + 사고력 트리플 분류 V4.4.0)
  // =========================================================
  const taxonomyGuides = useMemo(() => {
    const mainPrefixes = expandPrefixSpec(mainPrefixSpec);
    const filtCat = masterCategories.filter((c) =>
      matchesAnyPrefix(c.category_id, mainPrefixes)
    );
    const filtItem = masterItems.filter((i) =>
      matchesAnyPrefix(i.item_id, mainPrefixes)
    );
    const depth8IdSet = new Set(
      filtItem.map((i) => String(i.item_id).trim()).filter(Boolean)
    );

    const catMap = new Map<string, any>();
    for (const c of masterCategories) {
      catMap.set(String(c.category_id).trim(), c);
    }

    let currGuide = `### [1. 메인 교과 단원 분류표 (대상 범위: ${mainPrefixSpec} -> ${mainPrefixes.join(
      ", "
    )})]\n`;
    for (const c of filtCat) {
      currGuide += `- ${c.category_id}: ${c.depth7 || c.full_path || ""}\n`;
    }
    currGuide += `\n### [1-1. 메인 교과 세부유형 리스트 - item_id (taxonomy_id 매핑용)]\n`;
    for (const i of filtItem) {
      const parentCat = catMap.get(String(i.category_id || "").trim());
      const d8Label =
        i.depth8 ||
        i.item_name ||
        i.title ||
        (parentCat ? `${parentCat.depth7 || ""} (${i.item_id})` : i.item_id);
      currGuide += `- ${i.item_id}: ${d8Label}\n`;
    }

    const subPrefixes = expandPrefixSpec(subPrefixSpec);
    let subGuide = "";
    let subFiltCatCount = 0;
    let subFiltItemCount = 0;
    const subDepth8IdSet = new Set<string>();

    if (subPrefixes.length > 0) {
      const subFiltCat = masterCategories.filter((c) =>
        matchesAnyPrefix(c.category_id, subPrefixes)
      );
      const subFiltItem = masterItems.filter((i) =>
        matchesAnyPrefix(i.item_id, subPrefixes)
      );
      subFiltCatCount = subFiltCat.length;
      subFiltItemCount = subFiltItem.length;
      for (const i of subFiltItem) {
        if (i.item_id) subDepth8IdSet.add(String(i.item_id).trim());
      }

      subGuide = `### [2. 서브 교과 단원 분류표 (광범위 실제 교과 탐색 범위: ${subPrefixSpec} -> ${subPrefixes.join(
        ", "
      )})]\n`;
      for (const c of subFiltCat) {
        subGuide += `- ${c.category_id}: ${c.depth7 || c.full_path || ""}\n`;
      }
      subGuide += `\n### [2-1. 서브 교과 세부유형 리스트 - item_id (sub_taxonomy_id 매핑용)]\n`;
      for (const i of subFiltItem) {
        const parentCat = catMap.get(String(i.category_id || "").trim());
        const d8Label =
          i.depth8 ||
          i.item_name ||
          i.title ||
          (parentCat ? `${parentCat.depth7 || ""} (${i.item_id})` : i.item_id);
        subGuide += `- ${i.item_id}: ${d8Label}\n`;
      }
    }

    let thkGuide = "";
    if (applyThinking) {
      thkGuide = `### [3. 사고력 영역 분류표 (Prefix: THK)]\n`;
      for (const t of thinkingCategories) {
        thkGuide += `- ${t.category_id}: ${t.full_path}\n`;
      }
    }

    return {
      mainPrefixes,
      subPrefixes,
      filtCatCount: filtCat.length,
      filtItemCount: filtItem.length,
      subFiltCatCount,
      subFiltItemCount,
      depth8IdSet,
      subDepth8IdSet,
      currGuide,
      subGuide,
      thkGuide,
    };
  }, [
    mainPrefixSpec,
    subPrefixSpec,
    applyThinking,
    masterCategories,
    masterItems,
    thinkingCategories,
  ]);

  const handleRunPhase2Classification = async () => {
    if (problems.length === 0) {
      return alert("분류할 문항이 없습니다. 먼저 PDF 스캔 또는 JSON 불러오기를 실행하세요.");
    }
    if (taxonomyGuides.filtCatCount === 0 && taxonomyGuides.filtItemCount === 0) {
      return alert(
        `입력하신 메인 교과 단원 코드(${mainPrefixSpec})에 해당하는 마스터 분류가 없습니다. (예: E41, E4, E61, M11 등)`
      );
    }

    // 페이지 범위 파싱 (예: "15" 또는 "10-20")
    let startP = 0;
    let endP = 99999;
    const rangeTrim = classifyPageRange.trim();
    if (rangeTrim) {
      if (rangeTrim.includes("-")) {
        const [s, e] = rangeTrim.split("-").map((x) => parseInt(x.trim(), 10));
        if (!isNaN(s) && !isNaN(e)) {
          startP = Math.min(s, e);
          endP = Math.max(s, e);
        }
      } else {
        const single = parseInt(rangeTrim, 10);
        if (!isNaN(single)) {
          startP = single;
          endP = single;
        }
      }
    }

    const applySubTaxonomy = taxonomyGuides.subPrefixes.length > 0;

    // V4.4.0 needs_rework 필터링 로직
    const pendingTasks = problems.filter((q) => {
      const pNum =
        parseInt(String(q.detected_page_num || q.final_printed_page || 0), 10) || 0;
      if (pNum < startP || pNum > endP) return false;

      if (!classifyOnlyRework) return true;

      const status = q.classification_status;
      const taxId = String(q.taxonomy_id || "").trim();
      const subTaxId = String(q.sub_taxonomy_id || "").trim();

      if (status !== "COMPLETE" || !taxId || taxId === "None") return true;
      if (
        matchesAnyPrefix(taxId, taxonomyGuides.mainPrefixes) &&
        taxonomyGuides.depth8IdSet.size > 0 &&
        !taxonomyGuides.depth8IdSet.has(taxId)
      ) {
        return true;
      }
      if (applySubTaxonomy) {
        if (!subTaxId || subTaxId === "None") return true;
        if (
          matchesAnyPrefix(subTaxId, taxonomyGuides.subPrefixes) &&
          taxonomyGuides.subDepth8IdSet.size > 0 &&
          !taxonomyGuides.subDepth8IdSet.has(subTaxId)
        ) {
          return true;
        }
      }
      return false;
    });

    if (pendingTasks.length === 0) {
      return alert(
        "✅ 지정된 범위 내의 모든 문항이 이미 Depth 8까지 완벽하게 분류되어 있습니다! (전체를 다시 분류하려면 '미분류/Depth7 이하만 재분류' 체크를 해제하세요.)"
      );
    }

    setIsClassifying(true);
    setClassifyProgress({ completed: 0, total: pendingTasks.length });
    addLog(
      `🧭 [Phase 2 정밀 분류 시작] 대상 문항: ${pendingTasks.length}개 (메인: ${taxonomyGuides.mainPrefixes.join(
        ","
      )} / 서브: ${
        applySubTaxonomy ? taxonomyGuides.subPrefixes.join(",") : "미사용"
      } / 사고력: ${applyThinking ? "ON" : "OFF"})`
    );

    try {
      const {
        data: { session },
      } = await supabase.auth.getSession();
      const token = session?.access_token;

      const bSize = Math.max(1, Math.min(25, classifyBatchSize));
      const batches: any[][] = [];
      for (let i = 0; i < pendingTasks.length; i += bSize) {
        batches.push(pendingTasks.slice(i, i + bSize));
      }

      let completedCount = 0;
      let batchIdx = 0;
      const maxWorkers = 2; // V4.4.0 MAX_WORKERS = 2

      const runBatchWorker = async () => {
        while (batchIdx < batches.length) {
          const myBatch = batches[batchIdx++];
          try {
            const results = await fetchWithRetryAndTimeout(
              {
                action: "classify",
                batchData: myBatch,
                currGuide: taxonomyGuides.currGuide,
                subGuide: taxonomyGuides.subGuide,
                thkGuide: taxonomyGuides.thkGuide,
                applySubTaxonomy,
                applyThinking,
              },
              token,
              4,
              90000
            );

            if (Array.isArray(results) && results.length > 0) {
              const resultMap = new Map<string, any>();
              for (const r of results) {
                if (r?.question_id) resultMap.set(String(r.question_id), r);
              }

              setProblems((prev) => {
                const updated = prev.map((q) => {
                  const res = resultMap.get(String(q.question_id));
                  if (!res) return q;

                  const nextQ = { ...q };
                  nextQ.taxonomy_id = String(res.curriculum_id || "").trim() || null;
                  nextQ.taxonomy_name =
                    String(res.curriculum_name || "").trim() || "이름 누락됨";

                  if (applySubTaxonomy) {
                    const subId = String(res.sub_curriculum_id || "").trim();
                    if (subId && !["NONE", "NULL"].includes(subId.toUpperCase())) {
                      nextQ.sub_taxonomy_id = subId;
                      nextQ.sub_taxonomy_name =
                        String(res.sub_curriculum_name || "").trim() || "이름 누락됨";
                    } else {
                      nextQ.sub_taxonomy_id = null;
                      nextQ.sub_taxonomy_name = null;
                    }
                  }

                  if (applyThinking) {
                    const thkId = String(res.thinking_id || "").trim();
                    if (thkId && !["NONE", "NULL"].includes(thkId.toUpperCase())) {
                      nextQ.thk_taxonomy_id = thkId;
                      nextQ.thk_taxonomy_name =
                        String(res.thinking_name || "이름 누락됨").trim();
                    } else {
                      nextQ.thk_taxonomy_id = null;
                      nextQ.thk_taxonomy_name = null;
                    }
                  }

                  nextQ.difficulty = normalizeDifficultyForDb(res.difficulty);
                  nextQ.problem_type = res.problem_type || nextQ.problem_type;
                  nextQ.cognitive_level = res.cognitive_level || nextQ.cognitive_level;

                  if (
                    res.solving_probability !== null &&
                    res.solving_probability !== undefined
                  ) {
                    const probInt = parseInt(String(res.solving_probability), 10);
                    if (!isNaN(probInt)) {
                      nextQ.solving_probability = Math.max(15, Math.min(95, probInt));
                    }
                  }

                  nextQ.classification_status = "COMPLETE";
                  return normalizeRecordForQuestionDb(nextQ, bookTitle);
                });

                return sortProblemsList(updated);
              });

              completedCount += myBatch.length;
              setClassifyProgress({
                completed: Math.min(completedCount, pendingTasks.length),
                total: pendingTasks.length,
              });
              addLog(
                `✅ [타겟 분류 완료: ${Math.min(
                  completedCount,
                  pendingTasks.length
                )}/${pendingTasks.length}] 배치 저장 및 정렬 동기화 성공`
              );
            }
          } catch (batchErr: any) {
            addLog(`❌ 배치 분류 오류: ${batchErr.message}`);
          }
        }
      };

      await Promise.all(
        Array.from({ length: Math.min(maxWorkers, batches.length) }, () =>
          runBatchWorker()
        )
      );
      addLog(`🎉 [Phase 2 트리플 분류 완료] 총 ${pendingTasks.length}개 문항 분류 및 정렬이 완료되었습니다!`);
    } finally {
      setIsClassifying(false);
    }
  };

  // =========================================================
  // 🛠️ Phase 3 (V302): 수식 마법 도구, 텍스트 편집, 4슬롯 이미지 크롭 & 클립보드 붙여넣기
  // =========================================================
  const updateCurrentProblemField = useCallback(
    (field: string, value: any) => {
      if (!currentProblem) return;
      setProblems((prev) =>
        prev.map((item, idx) => {
          if (idx !== currentIdx) return item;
          const updated = { ...item, [field]: value };
          if (field === "book_name") {
            updated.source_book_name = value;
            setBookTitle(value);
          }
          return normalizeRecordForQuestionDb(updated, bookTitle);
        })
      );
    },
    [currentProblem, currentIdx, bookTitle]
  );

  const applyMagicFunction = (fn: (text: string) => string, label: string) => {
    if (problems.length === 0) return;
    setProblems((prev) =>
      prev.map((item, idx) => {
        if (!magicScopeAll && idx !== currentIdx) return item;
        const copy = { ...item };
        for (const f of TARGET_FIELDS) {
          if (copy[f] && typeof copy[f] === "string") {
            copy[f] = fn(copy[f]);
          }
        }
        return copy;
      })
    );
    addLog(
      `🪄 [${label}] ${
        magicScopeAll ? `전체 ${problems.length}문항` : `현재 문항(#${currentIdx + 1})`
      } 적용 완료`
    );
  };

  const handleAiFixLatex = async () => {
    if (!currentProblem) return;
    setIsAiFixingLatex(true);
    try {
      const {
        data: { session },
      } = await supabase.auth.getSession();
      const fieldsPayload: Record<string, string> = {};
      for (const f of TARGET_FIELDS) {
        if (currentProblem[f]) fieldsPayload[f] = currentProblem[f];
      }

      const res = await fetchWithRetryAndTimeout(
        {
          action: "fix_latex",
          fields: fieldsPayload,
        },
        session?.access_token,
        3,
        60000
      );

      if (res && typeof res === "object") {
        setProblems((prev) =>
          prev.map((item, idx) => {
            if (idx !== currentIdx) return item;
            const next = { ...item };
            for (const f of TARGET_FIELDS) {
              if (res[f] && typeof res[f] === "string") {
                next[f] = res[f].trim();
              }
            }
            return next;
          })
        );
        addLog(`🤖 AI 수식 자동 교정 완료 (문항 #${currentIdx + 1})`);
      }
    } catch (e: any) {
      alert(`AI 수식 교정 실패: ${e.message}`);
    } finally {
      setIsAiFixingLatex(false);
    }
  };

  // V302: 문제 1의 마지막 줄을 문제 2(question_2)로 내리기 / 다시 합치기
  const handleSplitLastLineToQ2 = () => {
    if (!currentProblem) return;
    const rawQ = String(currentProblem.question || "").trimEnd();
    const lines = rawQ.split("\n");
    if (lines.length < 2) {
      return alert(
        "문제 1(question)이 한 줄뿐이어서 자동 분리할 수 없습니다. 직접 잘라내어 붙여넣어 주세요."
      );
    }
    const lastLine = lines[lines.length - 1].trim();
    const remainQ = lines.slice(0, -1).join("\n").trimEnd();
    const existingQ2 = String(currentProblem.question_2 || "").trim();
    const newQ2 = existingQ2 ? `${lastLine}\n${existingQ2}`.trim() : lastLine;

    setProblems((prev) =>
      prev.map((item, idx) =>
        idx === currentIdx
          ? { ...item, question: remainQ, question_2: newQ2 }
          : item
      )
    );
  };

  const handleMergeQ2ToQ1 = () => {
    if (!currentProblem) return;
    const q2Curr = String(currentProblem.question_2 || "").trim();
    if (!q2Curr) return;
    const q1Curr = String(currentProblem.question || "").trimEnd();
    const mergedQ = q1Curr ? `${q1Curr}\n${q2Curr}`.trim() : q2Curr;

    setProblems((prev) =>
      prev.map((item, idx) =>
        idx === currentIdx
          ? { ...item, question: mergedQ, question_2: null }
          : item
      )
    );
  };

  // 이미지 슬롯 저장 헬퍼 (해상도 자동 측정 + image_box 기록)
  const attachImageBlobToProblem = useCallback(
    async (questionId: string, field: ImageSlotField, blob: Blob) => {
      const previewUrl = URL.createObjectURL(blob);
      const dims = await new Promise<{ w: number; h: number }>((resolve) => {
        const img = new Image();
        img.onload = () => resolve({ w: img.width, h: img.height });
        img.onerror = () => resolve({ w: 0, h: 0 });
        img.src = previewUrl;
      });

      const assetKey = `${questionId}_${field}`;
      setImageAssets((prev) => ({
        ...prev,
        [assetKey]: {
          blob,
          previewUrl,
          width: dims.w,
          height: dims.h,
        },
      }));

      const suffixMap: Record<ImageSlotField, string> = {
        image_url: "core_1",
        image_2_url: "core_2",
        answer_image_url: "sol_1",
        answer_image_2_url: "sol_2",
      };
